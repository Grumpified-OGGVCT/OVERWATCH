# OVERWATCH Configuration
# Copy this file to .env and fill in your actual values

# ============================================================================
# REQUIRED CONFIGURATION
# ============================================================================

# Ollama Proxy Configuration
OLLAMA_PROXY_URL=http://localhost:8081
OLLAMA_API_KEY=your-api-key-here

# ============================================================================
# SECURITY TOKENS (change these!)
# ============================================================================

# Webhook token for Alertmanager -> AI Layer communication
WEBHOOK_TOKEN=overwatch-secret-token-change-me

# Executor token for UI/AI Layer -> PowerShell Executor communication
EXECUTOR_TOKEN=executor-secret-token-change-me

# ============================================================================
# OPTIONAL CONFIGURATION (defaults provided)
# ============================================================================

# Grafana Admin Password
GRAFANA_PASSWORD=admin

# Executor URL (if running on different host)
EXECUTOR_URL=http://localhost:8080

# Database path (relative to project root)
DATABASE_PATH=./database/overwatch.db

# ============================================================================
# ALERT THRESHOLDS (adjust as needed)
# ============================================================================

# These are used by Prometheus alert rules
# Edit monitoring/prometheus/rules/process_alerts.yml to change alert behavior

# CPU threshold (0.0 to 1.0, where 0.8 = 80%)
CPU_THRESHOLD=0.8

# Memory threshold (0.0 to 1.0, where 0.8 = 80%)
MEMORY_THRESHOLD=0.8

# Orphan process minimum age in seconds (default: 1 hour)
ORPHAN_MIN_AGE_SECONDS=3600

# Zombie process minimum memory in MB
ZOMBIE_MIN_MEMORY_MB=50

# ============================================================================
# AI/LLM CONFIGURATION
# ============================================================================

# LLM model name (default: llama2)
LLM_MODEL=llama2

# Minimum confidence threshold for auto-approval (0.0 to 1.0)
# Below this threshold, always requires manual review
LLM_CONFIDENCE_THRESHOLD=0.7

# Prompt version (for tracking prompt changes)
PROMPT_VERSION=v1.0

# ============================================================================
# LOGGING
# ============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Executor log path (Windows)
EXECUTOR_LOG_PATH=C:\OVERWATCH\logs\executor.log
