FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir streamlit pandas requests python-dotenv

# Copy application code
COPY database/ ./database/
COPY ui/ ./ui/

# Expose Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "ui/streamlit_dashboard.py", "--server.port=8501", "--server.address=0.0.0.0"]
